# Public settings for the web app build (node app/build.mjs). Copy this file to .env and fill it in.
# Only PUBLIC values belong here. Never put the service_role key, the Stripe secret key, or the Anthropic key in this file.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPPORT_EMAIL=you@example.com
# Turn on the Subscribe and Manage buttons once the billing service and webhook are set up (docs/DEPLOY.md, payments).
# BILLING=on
# The price as people should read it. It must match the price you made in Stripe.
# PLAN_TEXT=$6 a month
# YEARLY_TEXT=$60 a year
