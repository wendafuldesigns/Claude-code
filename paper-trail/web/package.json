{
  "name": "paper-trail-web",
  "private": true,
  "type": "module",
  "description": "The Paper Trail web app: database, scan service, and app shell.",
  "scripts": {
    "build": "node app/build.mjs",
    "shared": "node app/extract-shared.mjs",
    "bundle": "node app/bundle-function.mjs",
    "icons": "node app/make-icons.mjs",
    "test:db": "node supabase/tests/db.test.mjs",
    "test:scan": "node supabase/tests/scan.test.mjs",
    "test:app": "node tests/app.test.mjs",
    "test": "node app/extract-shared.mjs --check && node app/bundle-function.mjs --check && npm run test:db && npm run test:scan && npm run test:app"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0"
  }
}
